# =============================================================================
# Cyber Command Center — root environment (for the top-level docker-compose.yml)
#
# The LIGHT DEMO NEEDS NONE OF THIS — `docker compose up -d` works with no .env
# at all (sensible defaults are baked into docker-compose.yml). Copy this file to
# `.env` only if you want to override defaults, or run the FULL platform.
#
#   cp .env.example .env
#
# For the complete bot configuration (monitoring intervals, channels, HTB, RAG,
# actioning, SMTP, dashboard auth, …) see services/discord-bot/.env.example.
# =============================================================================

# --- Database (compose provisions its own Postgres with these) ---------------
POSTGRES_USER=cyber
POSTGRES_PASSWORD=CyberSecure2026
POSTGRES_DB=cyberdb

# --- Dashboard ---------------------------------------------------------------
# Published port for the dashboard (http://localhost:<port>).
DASHBOARD_PORT=8080
# HTB owns target for the learning progress ring.
HTB_PROGRESS_GOAL=50
# Leave USER/PASS blank for open localhost demo. Set BOTH to require login,
# and API_KEY to require X-API-Key on /api/* endpoints.
DASHBOARD_USER=
DASHBOARD_PASS=
DASHBOARD_API_KEY=

# --- Full platform only (docker compose --profile full up -d) ----------------
# Required to actually run the Discord bot. Get it from the Developer Portal.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Optional: raises the NVD rate limit. https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Local Ollama published port (the bot talks to http://ollama:11434 internally).
OLLAMA_PORT=11434
