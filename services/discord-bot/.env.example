# =============================================================================
# Cyber Command Center — environment variables
# Copy this file to the PROJECT ROOT as `.env` and fill in the secrets.
#   cp services/discord-bot/.env.example .env
# =============================================================================

# --- Discord -----------------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=
# Your server (guild) ID. Right-click the server icon -> Copy Server ID
# (Developer Mode must be enabled). Used for instant slash-command syncing.
DISCORD_GUILD_ID=

# --- External APIs -----------------------------------------------------------
# Optional but recommended: raises NVD rate limit from 5 to 50 req / 30s.
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Reserved for a later phase (YouTube monitoring).
YOUTUBE_API_KEY=

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=192.168.8.185
POSTGRES_PORT=5432
POSTGRES_USER=cyber
POSTGRES_PASSWORD=CyberSecure2026
POSTGRES_DB=cyberdb

# --- Redis -------------------------------------------------------------------
REDIS_HOST=192.168.8.185
REDIS_PORT=6379

# --- Ollama (local AI) -------------------------------------------------------
OLLAMA_HOST=http://192.168.8.185:11434
# qwen2.5:3b is Ollama's instruct-tuned 3B model (fast, non-reasoning).
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=45
OLLAMA_RETRIES=3
# Max simultaneous Ollama requests (ceiling 2). Use 1 on CPU-only hosts —
# 2 concurrent requests queue inside Ollama and can exceed the timeout.
OLLAMA_MAX_CONCURRENCY=1

# --- Bot settings ------------------------------------------------------------
BOT_LOGS_CHANNEL=bot-logs
TIMEZONE=Asia/Colombo
CVE_MIN_SCORE=7.0
NEWS_FETCH_INTERVAL=7200
CVE_FETCH_INTERVAL=3600
DAILY_BRIEF_TIME=07:30

# --- Phase 2: autonomous monitoring -----------------------------------------
MONITORS_ENABLED=true
CVE_LOOKBACK_HOURS=24          # window used on the very first run
CVE_MAX_POSTS_PER_RUN=10       # cap posts per cycle so a backfill can't spam
CVE_POST_DELAY=3              # seconds between CVE posts
NEWS_MAX_PER_FEED=3           # max articles posted per feed per cycle
NEWS_POST_DELAY=30           # seconds between news posts

# --- Phase 2: target channels -----------------------------------------------
CVE_ALERTS_CHANNEL=cve-alerts
CYBER_NEWS_CHANNEL=cyber-news
DAILY_BRIEF_CHANNEL=daily-brief

# --- Phase 2: RSS sources (optional JSON override of the built-in defaults) --
# Example: RSS_FEEDS={"The Hacker News":"https://feeds.feedburner.com/TheHackersNews"}
RSS_FEEDS=

# --- Phase 3: threat-intelligence fusion ------------------------------------
ENRICHMENT_ENABLED=true
KEV_REFRESH_HOURS=6
EXPLOITDB_REFRESH_HOURS=24
# Optional source overrides (free defaults baked into config.py):
# EPSS_URL=https://api.first.org/data/v1/epss
# KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# EXPLOITDB_CSV_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv
# GITHUB_POC_BASE=https://raw.githubusercontent.com/nomi-sec/PoC-in-GitHub/master

# --- Phase 4: learning intelligence -----------------------------------------
# HackTheBox App Token (JWT): HTB > Profile Settings > App Tokens > Create.
# Empty = manual /practiced logging only (recommendations still work from logs).
HTB_APP_TOKEN=
HTB_API_BASE=https://labs.hackthebox.com/api/v4
HTB_REFRESH_HOURS=24
RECOMMEND_DAY=0            # 0=Mon .. 6=Sun
RECOMMEND_TIME=08:00      # local (Asia/Colombo) time for the weekly post
